# Stage 1: Build the Angular application
FROM node:22-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# 1. Accept the build argument passed from GitHub Actions
ARG reactCloudUri

# 2. Dynamically generate the environment file before building
RUN mkdir -p src/app/slice && \
    echo "export const environment = {" > src/app/slice/environment.ts && \
    echo "  production: true," >> src/app/slice/environment.ts && \
    echo "  reactCloudUri: '$reactCloudUri'" >> src/app/slice/environment.ts && \
    echo "};" >> src/app/slice/environment.ts

# 3. Build the app for production
RUN npm run build -- --configuration=production

# Stage 2: Serve with Nginx
FROM nginx:alpine

# Copy built static files from Stage 1 into Nginx
COPY --from=builder /app/dist/Dashboard/browser /usr/share/nginx/html

# 4. Change EXPOSE to port 80 to match Azure's target port
EXPOSE 80

ENTRYPOINT ["nginx", "-g", "daemon off;"]